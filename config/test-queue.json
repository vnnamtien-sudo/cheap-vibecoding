{
  "_readme": "测试排队参数。下面是按 64 GB 内存、24 线程的机器调的；16 GB / 32 GB 的起点见 README“按你的电脑调参”。先量（node tools/test-queue.cjs stats）再调。",
  "hookEnabled": true,
  "slots": 20,
  "poolCountsSessions": true,
  "_sessionDirs": "总池要数的会话目录：哪家没装就是 0，不用删。depth = 记录文件在目录下第几层；datedDays = 只看最近几天的 年/月/日 文件夹。DeepSeek 接在 Claude Code 上，记录在 Claude 那一行里。",
  "sessionDirs": [
    { "name": "claude", "path": "~/.claude/projects", "ext": ".jsonl", "depth": 2 },
    { "name": "codex", "path": "~/.codex/sessions", "ext": ".jsonl", "depth": 4, "datedDays": 3 },
    { "name": "gemini-cli", "path": "~/.gemini/tmp", "ext": ".json", "depth": 3 }
  ],
  "activeSessionMinutes": 10,
  "minTestSlots": 2,
  "heavyMax": 2,
  "heavyOnlyLabels": true,
  "heavyLabels": "merge|verify|nightly",
  "autoWeight": 4,
  "timeoutMinutes": 15,
  "minFreeGB": 8,
  "staleMinutes": 20,
  "pollMs": 2000,
  "dataDir": "data/test-queue"
}
