{
  "_readme": "Google Antigravity CLI（agy）的钩子：放到项目的 .agents/hooks.json，或全局 ~/.gemini/config/hooks.json（写进 settings.json 不生效）。/path/to/cheap-vibecoding 换成你克隆的位置。照官方文档写，作者没有在本机实测。",
  "cheap-vibecoding": {
    "PreToolUse": [
      {
        "matcher": "view_file|run_command",
        "hooks": [
          { "type": "command", "command": "node /path/to/cheap-vibecoding/hooks/read-limit-hook.cjs --agent antigravity", "timeout": 15 }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node /path/to/cheap-vibecoding/hooks/test-queue-hook.cjs --agent antigravity", "timeout": 15 }
        ]
      }
    ]
  }
}
